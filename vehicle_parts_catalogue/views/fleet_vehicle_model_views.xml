<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_model_view_form_inherit_parts" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.form.inherit.parts</field>
        <field name="model">fleet.vehicle.model</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Vehicle Parts" name="vehicle_parts">
                        <field name="part_ids">
                            <tree editable="bottom">
                                <field name="inspection_item_id"/>
                                <field name="specification_id"/>
                                <field name="qty"/>
                                <field name="group_id"/>
                                <field name="category_id"/>
                                <field name="product_ids" widget="many2many_tags"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
