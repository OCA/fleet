<odoo>
    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field
            name="name"
        >fleet.vehicle.form (in fleet_vehicle_analytic_purchase)</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_purchase_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    invisible="not analytic_distribution"
                    help="Show the purchase orders sharing an analytic account with this vehicle"
                >
                    <field
                        name="purchase_order_count"
                        widget="statinfo"
                        string="Purchase Orders"
                    />
                </button>
            </div>
            <field name="vin_sn" position="after">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    options="{'business_domain': 'general'}"
                />
            </field>
        </field>
    </record>
</odoo>
