<odoo>
    <record id="view_purchase_order_filter" model="ir.ui.view">
        <field
            name="name"
        >request.quotation.select (in fleet_vehicle_analytic_purchase)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field
                    name="distribution_analytic_account_ids"
                    string="Analytic Account"
                />
            </field>
        </field>
    </record>

    <record id="purchase_order_view_search" model="ir.ui.view">
        <field
            name="name"
        >purchase.order.select (in fleet_vehicle_analytic_purchase)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field
                    name="distribution_analytic_account_ids"
                    string="Analytic Account"
                />
            </field>
        </field>
    </record>

    <record id="purchase_order_view_tree" model="ir.ui.view">
        <field
            name="name"
        >purchase.order.list (in fleet_vehicle_analytic_purchase)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field
                    name="distribution_analytic_account_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
            </field>
        </field>
    </record>
</odoo>
