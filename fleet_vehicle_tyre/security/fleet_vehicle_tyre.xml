<odoo>
    <record id="access_fleet_vehicle_tyre_user" model="ir.model.access">
        <field name="name">fleet.vehicle.tyre user</field>
        <field name="model_id" ref="model_fleet_vehicle_tyre" />
        <field name="group_id" ref="fleet.fleet_group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="access_fleet_vehicle_tyre_manager" model="ir.model.access">
        <field name="name">fleet.vehicle.tyre manager</field>
        <field name="model_id" ref="model_fleet_vehicle_tyre" />
        <field name="group_id" ref="fleet.fleet_group_manager" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
