<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_fleet_telemetry_list" model="ir.ui.view">
        <field name="name">fleet.telemetry.list</field>
        <field name="model">fleet.telemetry</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="fix_time" />
                <field name="provider" />
                <field name="vehicle_id" />
                <field name="device_id" />
                <field name="latitude" />
                <field name="longitude" />
                <field name="speed" />
                <field name="address" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_fleet_telemetry_form" model="ir.ui.view">
        <field name="name">fleet.telemetry.form</field>
        <field name="model">fleet.telemetry</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="provider" />
                            <field name="vehicle_id" />
                            <field name="device_id" />
                            <field name="external_device_ref" />
                            <field name="external_position_ref" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="fix_time" />
                            <field name="server_time" />
                            <field name="speed" />
                            <field name="course" />
                        </group>
                    </group>
                    <group string="Position">
                        <field name="latitude" />
                        <field name="longitude" />
                        <field name="altitude" />
                        <field name="address" />
                    </group>
                    <group string="Attributes">
                        <field name="attributes" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fleet_telemetry_search" model="ir.ui.view">
        <field name="name">fleet.telemetry.search</field>
        <field name="model">fleet.telemetry</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id" />
                <field name="device_id" />
                <field name="provider" />
                <field name="route_day" />
                <filter string="Route Day" name="route_day_filter" date="route_day" />
                <filter
                    string="Last 7 Days"
                    name="last_7_days"
                    domain="[('route_day', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"
                />
                <separator />
                <filter
                    string="Vehicle"
                    name="group_vehicle"
                    context="{'group_by': 'vehicle_id'}"
                />
                <filter
                    string="Device"
                    name="group_device"
                    context="{'group_by': 'device_id'}"
                />
                <filter
                    string="Provider"
                    name="group_provider"
                    context="{'group_by': 'provider'}"
                />
                <filter
                    string="Route Day"
                    name="group_route_day"
                    context="{'group_by': 'route_day'}"
                />
            </search>
        </field>
    </record>

    <record id="action_fleet_telemetry" model="ir.actions.act_window">
        <field name="name">Fleet Telemetry</field>
        <field name="res_model">fleet.telemetry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fleet_telemetry_search" />
        <field name="context">{"create": false}</field>
    </record>
</odoo>
