<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_fleet_telemetry_device_list" model="ir.ui.view">
        <field name="name">fleet.telemetry.device.list</field>
        <field name="model">fleet.telemetry.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="provider" />
                <field name="external_ref" />
                <field name="vehicle_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_fleet_telemetry_device_form" model="ir.ui.view">
        <field name="name">fleet.telemetry.device.form</field>
        <field name="model">fleet.telemetry.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="provider" />
                            <field name="external_ref" />
                            <field name="vehicle_id" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_fleet_telemetry_device" model="ir.actions.act_window">
        <field name="name">Telemetry Devices</field>
        <field name="res_model">fleet.telemetry.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
