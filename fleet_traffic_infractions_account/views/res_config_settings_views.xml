<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_fleet_infraction" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fleet.infraction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="fleet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='fleet_settings']" position="inside">
                <h2>Traffic Infractions</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="infraction_bill_method"/>
                            <div class="text-muted">
                                Choose the default accounting method for agency fines.
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="infraction_bill_method" class="o_light_label" widget="radio"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>