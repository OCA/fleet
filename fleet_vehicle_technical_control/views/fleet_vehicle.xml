<odoo>
    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Technical Control" name="technical_control">
                    <group>
                        <group string="Planning">
                            <field name="technical_control_every_months" />
                            <field name="date_last_technical_control" readonly="1" />
                            <field name="date_next_technical_control" readonly="1" />
                        </group>
                        <group string="Actions" groups="fleet.fleet_group_manager">
                            <button
                                name="action_technical_control_done"
                                string="Technical Control Done"
                                type="object"
                                class="btn-primary"
                            />
                        </group>
                    </group>
                    <group string="History">
                        <field name="technical_control_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="date" />
                                <field name="result" />
                                <field name="comment" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
