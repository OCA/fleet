<odoo>
    <record id="fleet_vehicle_technical_control_view_form" model="ir.ui.view">
        <field name="model">fleet.vehicle.technical.control</field>
        <field name="arch" type="xml">
            <form string="Technical Control Done">
                <group>
                    <field name="vehicle_id" readonly="True" />
                    <field name="date" />
                    <field name="result" widget="radio" />
                    <field name="comment" required="result == 'not_valid'" />
                    <field name="attachment_filename" invisible="1" />
                    <field name="attachment_id" filename="attachment_filename" />
                </group>
            </form>
        </field>
    </record>
</odoo>
